---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="RysthDesign's Component Library">
  <div class="min-h-screen bg-gradient-to-br from-purple-50 to-blue-50">
    <!-- Header -->
    <header class="py-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">
        Landing Page Component Library
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto px-4">
        Explore our collection of beautiful, responsive components for building stunning landing pages
      </p>
    </header>

    <!-- Component Categories Grid -->
    <section class="max-w-7xl mx-auto px-4 pb-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

        <!-- Navigation Bars Card -->
        <a
          href="/navbars"
          class="group block bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden transform hover:-translate-y-2"
        >
          <div class="bg-gradient-to-br from-purple-500 to-purple-600 p-8 text-white">
            <i class="bx bx-navigation text-5xl mb-4"></i>
            <h2 class="text-2xl font-bold">Navigation Bars</h2>
          </div>
          <div class="p-6">
            <p class="text-gray-600 mb-4">
              3 unique, responsive navbar designs - from minimal to feature-rich
            </p>
            <div class="flex items-center text-purple-600 font-semibold group-hover:gap-2 transition-all">
              View Templates
              <i class="bx bx-right-arrow-alt text-2xl group-hover:translate-x-1 transition-transform"></i>
            </div>
          </div>
        </a>

        <!-- Hero Sections Card -->
        <a
          href="/heroes"
          class="group block bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden transform hover:-translate-y-2 opacity-50 cursor-not-allowed pointer-events-none"
        >
          <div class="bg-gradient-to-br from-blue-500 to-blue-600 p-8 text-white">
            <i class="bx bx-layout text-5xl mb-4"></i>
            <h2 class="text-2xl font-bold">Hero Sections</h2>
          </div>
          <div class="p-6">
            <p class="text-gray-600 mb-4">
              3 stunning hero section layouts to capture attention
            </p>
            <div class="flex items-center text-gray-400 font-semibold">
              Coming Soon
            </div>
          </div>
        </a>

        <!-- About Sections Card -->
        <a
          href="/about"
          class="group block bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden transform hover:-translate-y-2 opacity-50 cursor-not-allowed pointer-events-none"
        >
          <div class="bg-gradient-to-br from-green-500 to-green-600 p-8 text-white">
            <i class="bx bx-info-circle text-5xl mb-4"></i>
            <h2 class="text-2xl font-bold">About Sections</h2>
          </div>
          <div class="p-6">
            <p class="text-gray-600 mb-4">
              3 creative ways to showcase your story and team
            </p>
            <div class="flex items-center text-gray-400 font-semibold">
              Coming Soon
            </div>
          </div>
        </a>

        <!-- Footers Card -->
        <a
          href="/footers"
          class="group block bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden transform hover:-translate-y-2 opacity-50 cursor-not-allowed pointer-events-none"
        >
          <div class="bg-gradient-to-br from-orange-500 to-orange-600 p-8 text-white">
            <i class="bx bx-dock-bottom text-5xl mb-4"></i>
            <h2 class="text-2xl font-bold">Footers</h2>
          </div>
          <div class="p-6">
            <p class="text-gray-600 mb-4">
              3 professional footer designs for your site
            </p>
            <div class="flex items-center text-gray-400 font-semibold">
              Coming Soon
            </div>
          </div>
        </a>

        <!-- More Coming Soon Card -->
        <div class="block bg-white rounded-2xl shadow-lg overflow-hidden border-2 border-dashed border-gray-300">
          <div class="bg-gradient-to-br from-gray-400 to-gray-500 p-8 text-white">
            <i class="bx bx-plus-circle text-5xl mb-4"></i>
            <h2 class="text-2xl font-bold">More Components</h2>
          </div>
          <div class="p-6">
            <p class="text-gray-600 mb-4">
              Additional sections and components coming soon
            </p>
            <div class="flex items-center text-gray-500 font-semibold">
              In Development
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Footer Info -->
    <footer class="text-center py-8 text-gray-600">
      <p>Built with Astro, Tailwind CSS, and DaisyUI</p>
      <a
        href="http://www.rysthdesign.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 mt-4 text-purple-600 hover:text-purple-700 font-semibold"
      >
        <i class="bx bx-link-external"></i>
        Visit RysthDesign.com
      </a>
    </footer>
  </div>
</Layout>
