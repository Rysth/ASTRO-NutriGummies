---
import Layout from "@/layouts/Layout.astro";
import Navbar1 from "@/components/navbars/Navbar1.astro";
import Navbar2 from "@/components/navbars/Navbar2.astro";
import Navbar3 from "@/components/navbars/Navbar3.astro";
---

<Layout title="Navigation Bar Templates - RysthDesign">
  <div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <div class="bg-white shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-4">
        <div class="flex items-center justify-between">
          <div>
            <a href="/" class="text-purple-600 hover:text-purple-700 flex items-center gap-2 mb-2">
              <i class="bx bx-arrow-back text-xl"></i>
              Back to Components
            </a>
            <h1 class="text-3xl font-bold text-gray-800">Navigation Bar Templates</h1>
            <p class="text-gray-600 mt-1">3 unique, responsive navbar designs</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Template Showcase -->
    <div class="max-w-7xl mx-auto px-4 py-12 space-y-16">

      <!-- Navbar 1 -->
      <section id="navbar-1">
        <div class="mb-6">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-3">
                <span class="w-10 h-10 bg-purple-100 text-purple-600 rounded-lg flex items-center justify-center font-bold">1</span>
                Modern Minimal
              </h2>
              <p class="text-gray-600 mt-1 ml-13">Clean, minimalist design with smooth transitions</p>
            </div>
            <a
              href="https://github.com/RysthDesign/ASTRO-Template/blob/main/src/components/navbars/Navbar1.astro"
              target="_blank"
              class="btn btn-sm btn-outline gap-2"
            >
              <i class="bx bx-code-alt"></i>
              View Code
            </a>
          </div>
          <div class="flex flex-wrap gap-2 ml-13">
            <span class="badge badge-primary">Minimal</span>
            <span class="badge badge-secondary">Responsive</span>
            <span class="badge badge-accent">Mobile Menu</span>
          </div>
        </div>
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-200">
          <Navbar1 />
          <div class="p-8 bg-gradient-to-br from-gray-50 to-gray-100 min-h-[300px] flex items-center justify-center">
            <div class="text-center">
              <i class="bx bx-layout text-6xl text-gray-300 mb-4"></i>
              <p class="text-gray-500">Content area - Your page content goes here</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Navbar 2 -->
      <section id="navbar-2">
        <div class="mb-6">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-3">
                <span class="w-10 h-10 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center font-bold">2</span>
                Professional with Search
              </h2>
              <p class="text-gray-600 mt-1 ml-13">Feature-rich with search, notifications, and user account</p>
            </div>
            <a
              href="https://github.com/RysthDesign/ASTRO-Template/blob/main/src/components/navbars/Navbar2.astro"
              target="_blank"
              class="btn btn-sm btn-outline gap-2"
            >
              <i class="bx bx-code-alt"></i>
              View Code
            </a>
          </div>
          <div class="flex flex-wrap gap-2 ml-13">
            <span class="badge badge-primary">Professional</span>
            <span class="badge badge-secondary">Search Bar</span>
            <span class="badge badge-accent">User Profile</span>
            <span class="badge badge-info">Dropdown Menu</span>
          </div>
        </div>
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-200">
          <Navbar2 />
          <div class="p-8 bg-gradient-to-br from-blue-50 to-indigo-50 min-h-[300px] flex items-center justify-center">
            <div class="text-center">
              <i class="bx bx-search-alt text-6xl text-blue-300 mb-4"></i>
              <p class="text-gray-500">Content area - Your page content goes here</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Navbar 3 -->
      <section id="navbar-3">
        <div class="mb-6">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-3">
                <span class="w-10 h-10 bg-gradient-to-br from-purple-100 to-pink-100 text-purple-600 rounded-lg flex items-center justify-center font-bold">3</span>
                Creative with User Profile
              </h2>
              <p class="text-gray-600 mt-1 ml-13">Bold colors, gradients, and social media integration</p>
            </div>
            <a
              href="https://github.com/RysthDesign/ASTRO-Template/blob/main/src/components/navbars/Navbar3.astro"
              target="_blank"
              class="btn btn-sm btn-outline gap-2"
            >
              <i class="bx bx-code-alt"></i>
              View Code
            </a>
          </div>
          <div class="flex flex-wrap gap-2 ml-13">
            <span class="badge badge-primary">Creative</span>
            <span class="badge badge-secondary">Gradient Design</span>
            <span class="badge badge-accent">Social Media</span>
            <span class="badge badge-info">User Dropdown</span>
            <span class="badge badge-warning">Glassmorphism</span>
          </div>
        </div>
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-200">
          <Navbar3 />
          <div class="p-8 bg-gradient-to-br from-purple-50 via-pink-50 to-orange-50 min-h-[300px] flex items-center justify-center">
            <div class="text-center">
              <i class="bx bx-palette text-6xl text-purple-300 mb-4"></i>
              <p class="text-gray-500">Content area - Your page content goes here</p>
            </div>
          </div>
        </div>
      </section>

    </div>

    <!-- Usage Guide -->
    <div class="max-w-7xl mx-auto px-4 pb-12">
      <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-200">
        <h3 class="text-2xl font-bold text-gray-800 mb-4 flex items-center gap-2">
          <i class="bx bx-info-circle text-purple-600"></i>
          How to Use
        </h3>
        <div class="prose max-w-none">
          <ol class="space-y-3">
            <li class="text-gray-700">
              <strong>Import the component:</strong> Add the import statement to your Astro page
              <pre class="bg-gray-100 p-3 rounded-lg mt-2"><code>import Navbar1 from "@/components/navbars/Navbar1.astro";</code></pre>
            </li>
            <li class="text-gray-700">
              <strong>Add to your layout:</strong> Include the component in your page or layout file
              <pre class="bg-gray-100 p-3 rounded-lg mt-2"><code>&lt;Navbar1 /&gt;</code></pre>
            </li>
            <li class="text-gray-700">
              <strong>Customize:</strong> Edit the component file to change colors, links, and content to match your brand
            </li>
            <li class="text-gray-700">
              <strong>Responsive:</strong> All navbars are mobile-responsive with working hamburger menus
            </li>
          </ol>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="text-center py-8 text-gray-600 border-t border-gray-200 bg-white">
      <p>Part of RysthDesign's Component Library</p>
      <a
        href="http://www.rysthdesign.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 mt-4 text-purple-600 hover:text-purple-700 font-semibold"
      >
        <i class="bx bx-link-external"></i>
        Visit RysthDesign.com
      </a>
    </footer>
  </div>
</Layout>
